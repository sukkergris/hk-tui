#!/usr/bin/env bash
# hk – terminal client for Chromecast speakers (made for a Harman Kardon Citation): the albums in ~/Music in fzf
# with vim keys, "now playing" in the footer. Unofficial; not affiliated with Google or Harman Kardon.
#
# Playback runs in hk-cast, a small daemon per speaker that keeps the Cast connection, serves the files and plays
# the queue; this script talks to it with curl over a unix socket.
# The UI calls itself (_show/_enter/_key/_tracks/_preview/_now/_ticker) from fzf key bindings and the ticker loop.
# Rows (fzf fields separated by TAB or " ‒ " (U+2012), so artist and album are searchable separately; the last
# field, {-1}, is always the key):
#   albums:   Artist ‒ Album (Year)     <TAB> dir  (relative to the music dir; from the first track's tags)
#   tracks:   ▶ Title <TAB> (empty)     <TAB> file (relative to the music dir)
#   songs:    ▶ Title ‒ Artist • Album  <TAB> file (all tracks, for the track search)
#   speakers: ▶ Name ‒ IP               <TAB> IP
set -euo pipefail
(( BASH_VERSINFO[0] >= 5 )) || { echo "hk needs bash >= 5" >&2; exit 1; }
self=$(readlink -f "${BASH_SOURCE[0]}")
app="hk 0.8.0"  # name and version shown at the top of the UI

# Config: host=<speaker IP>, music=<music dir> (default ~/Music)
config=${XDG_CONFIG_HOME:-$HOME/.config}/hk/config
host="" music=$HOME/Music
# shellcheck source=/dev/null
[[ -f $config ]] && source "$config"
HK_HOST=${HK_HOST:-$host}
music=${music%/}
save_config() { mkdir -p "${config%/*}"; printf 'host=%s\nmusic=%s\n' "$HK_HOST" "$music" >"$config"; }
run=${XDG_RUNTIME_DIR:-/tmp}
cachedir=${XDG_CACHE_HOME:-$HOME/.cache}/hk  # tags.tsv: artist, year and album per folder (read again when it changes)
ext='mp3|flac|m4a|aac|ogg|opus|wav'
uilog=$run/hk-ui.log  # errors from the UI's sub-calls; the newest is shown in the status line for 15 s
if [[ ${1:-} == _* ]]; then  # a sub-call from fzf: its errors would vanish, so log them (with where they happened)
    sub=$1
    exec 2>>"$uilog"
    set -E
    # shellcheck disable=SC2154  # e is set inside the trap
    trap 'e=$?; echo "$(date +%T) ! hk $sub, line $LINENO: $BASH_COMMAND (exit $e)" >&2' ERR
fi

# --- Speakers ---

info() { curl -s --connect-timeout 1 --max-time 2 "http://$1:8008/setup/eureka_info"; }  # Cast device info (JSON)
name() { local n; n=$(grep -oE '"name":"[^"]*"' <<<"$1" | cut -d'"' -f4); printf '%b' "$n"; }  # ø → ø
local_ip() { ip -4 -o route get 1.1.1.1 | grep -oE 'src [0-9.]+' | cut -d' ' -f2; }

# Cast speakers on the local network ("IP Name"); assumes a /24 network
scan() {
    local net
    net=$(local_ip)
    net=${net%.*}
    for i in {1..254}; do
        (s=$(info "$net.$i") && [[ -n $s ]] && echo "$net.$i $(name "$s")") &
    done
    wait
}

# --- Player daemon (hk-cast) ---

ctl() { curl -sf --max-time 5 --unix-socket "$run/hk-$HK_HOST.sock" "http://hk/$1" "${@:2}"; }
player() {  # start hk-cast for the speaker unless it is running
    ctl ping &>/dev/null && return
    info "$HK_HOST" >/dev/null || {
        echo "hk: no answer from speaker at $HK_HOST. If its IP changed, run 'hk scan' and 'hk use <IP>'" >&2
        return 1
    }
    echo "Connecting to $HK_HOST…" >&2
    setsid "${self%/*}/hk-cast" "$HK_HOST" "$music" "$run/hk-$HK_HOST.sock" </dev/null &>"$run/hk-$HK_HOST.log" &
    for _ in {1..50}; do ctl ping &>/dev/null && return; sleep 0.2; done
    echo "hk: the player did not start; see $run/hk-$HK_HOST.log" >&2
    return 1
}

# --- Library ---

# Artist, year and album from the tags of the first track in folder $1, as "artist<TAB>year<TAB>album"
tags() {
    local f t a y b
    f=$(find -L "$1" -maxdepth 1 -type f -regextype posix-extended -iregex ".*\.($ext)" | sort -V | head -1)
    t=$(ffprobe -v quiet -show_entries format_tags=album_artist,artist,album,date,year -of default=nw=1 "$f" | tr '\t' ' ')
    a=$(sed -n 's/^TAG:album_artist=//Ip' <<<"$t" | head -1)
    [[ -n $a ]] || a=$(sed -n 's/^TAG:artist=//Ip' <<<"$t" | head -1)
    y=$(grep -ioE '^TAG:(date|year)=[0-9]{4}' <<<"$t" | head -1 | grep -oE '[0-9]{4}$' || true)
    b=$(sed -n 's/^TAG:album=//Ip' <<<"$t" | head -1)
    printf '%s\t%s\t%s\n' "$a" "$y" "$b"
}
# Folders with audio files as "Artist ‒ Album (Year)<TAB>dir", sorted by artist, year, album.
# Tags are cached per folder (tags.tsv: dir, mtime, artist, year, album); only new or changed folders are read.
albums() {
    local d rel m a y b v i=0
    local -A known
    local -a dirs todo
    mkdir -p "$cachedir"; touch "$cachedir/tags.tsv"
    while IFS=$'\t' read -r d m a y b; do known[$d]=$m$'\t'$a$'\t'$y$'\t'$b; done <"$cachedir/tags.tsv"
    mapfile -t dirs < <(find -L "$music" -type f -regextype posix-extended -iregex ".*\.($ext)" -printf '%h\n' | sort -u)
    for d in "${dirs[@]}"; do
        rel=${d#"$music"} rel=${rel#/}
        [[ -n $rel ]] || continue  # the music folder itself: "(loose files)", no tags
        v=${known[$rel]-}
        [[ ${v%%$'\t'*} != "$(stat -c %Y "$d")" ]] && todo+=("$d")  # new, or changed since it was read
    done
    for d in "${todo[@]}"; do  # new or changed folders: read their tags (~60 ms each)
        busy "Reading artists and years $((++i))/${#todo[@]}…"
        rel=${d#"$music/"} m=$(stat -c %Y "$d")
        known[$rel]=$m$'\t'$(tags "$d")
        printf '%s\t%s\n' "$rel" "${known[$rel]}" >>"$cachedir/tags.tsv"
    done
    for d in "${dirs[@]}"; do
        rel=${d#"$music"} rel=${rel#/}
        if [[ -z $rel ]]; then printf '2\t\t9999\t(loose files)\t.\n'; continue; fi
        IFS=$'\t' read -r m a y b <<<"${known[$rel]-}"
        printf '%s\t%s\t%s\t%s\t%s\n' "$([[ -n $a ]] && echo 0 || echo 1)" "$a" "${y:-9999}" "${b:-${rel##*/}}" "$rel"
    done | sort -t$'\t' -k1,1n -k2,2f -k3,3n -k4,4f |  # albums without an artist tag last, then the loose files
        awk -F'\t' '{ t = ($2 == "" ? "(unknown)" : $2) " ‒ " $4; if ($3 != 9999) t = t " (" $3 ")"; print t "\t" $5 }'
}
songs() {  # all tracks as "Title ‒ Artist • Album<TAB>file", in album order (for the track search)
    local cur row dir f rel
    cur=$(ctl current 2>/dev/null || true)
    while IFS=$'\t' read -r row dir; do
        while IFS= read -r f; do
            rel=$f
            [[ $dir != . ]] && rel=$dir/$f
            row=${row% (*}  # "Artist ‒ Album"
            if [[ $rel == "$cur" ]]; then printf '\e[1;32m▶ %s ‒ %s • %s\e[0m\t%s\n' "${f%.*}" "${row%% ‒ *}" "${row#* ‒ }" "$rel"
            else printf '  %s ‒ %s • %s\t%s\n' "${f%.*}" "${row%% ‒ *}" "${row#* ‒ }" "$rel"; fi
        done < <(find -L "$music/$dir" -maxdepth 1 -type f -regextype posix-extended -iregex ".*\.($ext)" -printf '%f\n' | sort -V)
    done <"$HK_DIR/albums"
}
tracks() {  # $1 = dir; the track playing is green
    local cur f rel
    cur=$(ctl current 2>/dev/null || true)
    find -L "$music/$1" -maxdepth 1 -type f -regextype posix-extended -iregex ".*\.($ext)" -printf '%f\n' | sort -V |
        while IFS= read -r f; do
            rel=$f
            [[ -n $1 && $1 != . ]] && rel=$1/$f
            if [[ $rel == "$cur" ]]; then printf '\e[1;32m▶ %s\e[0m\t\t%s\n' "${f%.*}" "$rel"; else printf '  %s\t\t%s\n' "${f%.*}" "$rel"; fi
        done
}

# --- UI ---

st()  { cat "$HK_DIR/$1" 2>/dev/null || true; }  # read state
put() { echo "$2" >"$HK_DIR/$1"; }
# The chosen speaker is kept in state, so all sub-calls follow along when it changes
[[ -n ${HK_DIR:-} && -s ${HK_DIR:-}/host ]] && read -r HK_HOST <"$HK_DIR/host"

# --- Status line (the footer label, just above "now playing"): what hk is waiting for, with a spinner ---
# Each slow job writes its message to $HK_DIR/busy.<pid>; the ticker shows the newest one while that process lives.
busy() { echo "$1" >"$HK_DIR/busy.$BASHPID"; }
spinner=(⠋ ⠙ ⠹ ⠸ ⠼ ⠴ ⠦ ⠧ ⠇ ⠏)
fzf_do() { curl -sf --max-time 1 --unix-socket "$HK_DIR/fzf.sock" -XPOST http://localhost -d "$1" >/dev/null; }  # run fzf actions; fails if fzf didn't take them
mtime() { stat -c %Y "$1" 2>/dev/null || echo 0; }  # 0 if the file is gone (it may vanish while we look)
status_line() {  # $1 = frame number, $2 = "now playing" from the player ("" = the player doesn't answer)
    local f msg="" age=0 err
    for f in "$HK_DIR"/busy.*; do
        [[ -e $f ]] || continue
        kill -0 "${f##*.}" 2>/dev/null || { rm -f "$f"; continue; }
        msg=$(cat "$f" 2>/dev/null) age=$((EPOCHSECONDS - $(mtime "$f")))
    done
    if [[ -n $msg ]]; then
        (( age >= 2 && age < 100000 )) && msg+=" ${age}s"
        echo " ${spinner[$1 % 10]} $msg "
    elif (( EPOCHSECONDS - $(mtime "$uilog") < 15 )) && err=$(tail -1 "$uilog") && [[ $err != *" UI "@(started|exited)* ]]; then
        err=${err#[0-9][0-9]:[0-9][0-9]:[0-9][0-9] }
        echo " ! ${err#! } – see $uilog "
    elif [[ -z $2 ]]; then
        echo " ! The player doesn't answer – see $run/hk-$HK_HOST.log "
    elif [[ $(st tab) == speakers ]]; then
        echo " enter: use this speaker · r: scan again "
    else
        echo " Press ? for shortcuts "
    fi
}

speakers() {  # ▶ = the chosen one
    scan | sort -t. -k4,4n | while read -r ip n; do
        if [[ $ip == "$HK_HOST" ]]; then printf '▶ %s ‒ %s\t%s\n' "$n" "$ip" "$ip"; else printf '  %s ‒ %s\t%s\n' "$n" "$ip" "$ip"; fi
    done
}

# Views: print fzf actions. The label is set last with "action:text", so parentheses in names don't break it.
bold() { local t=${1//\[ /$'\e[1m'[ }; echo "${t// \]/ ]$'\e[22m'}"; }  # the current tab, "[ … ]", in bold
label() { echo "change-border-label: $app │ $(st name) │ $(bold "$1") "; }
scope() { local s; s=$(st scope); echo "${s:-album}"; }  # what / searches: album, artist or track (tab switches)
nth() { if [[ $(scope) == artist ]]; then echo 1; else echo 2; fi; }
to_albums() {  # $1 = action after reload (pos or first)
    put tab albums
    echo "reload-sync($self _show albums)+$1+change-nth($(nth))+change-prompt($(scope)> )+change-preview-window(right,45%)+$(label '[ Music (gm) ]  Tracks  Speakers (gS)')"
}
to_tracks() {  # $1 = artist, $2 = album, $3 = dir, $4 = index in the album list
    put tab tracks; put dir "$3"; put apos "$4"
    echo "clear-query+reload-sync($self _tracks)+first+change-nth(1)+change-prompt(track> )+change-preview-window(hidden)+$(label "Music (gm)  [ ${1#  } – $2 ]  Speakers (gS)")"
}
to_songs() {  # the track search: all tracks, searched by title
    put tab songs
    echo "reload($self _show songs)+first+change-nth(1)+change-prompt(track> )+change-preview-window(hidden)+$(label "Music (gm)  [ All tracks ]  Speakers (gS)")"
}
to_speakers() {
    put tab speakers
    echo "clear-query+reload($self _show speakers)+first+change-nth(1)+change-prompt(speaker> )+change-preview-window(hidden)+$(label 'Music (gm)  Tracks  [ Speakers (gS) ]')"
}
back_to_albums() {
    [[ $(scope) == track ]] && put scope album
    echo "clear-query+$(to_albums "pos($(($(st apos) + 1)))")"
}

usage() {
    cat <<EOF
$app – terminal client for Chromecast speakers (unofficial)

Usage: hk [command]

  (none)          open the UI
  play PATH...    play files or album folders (inside the music dir)
  pause           pause / resume
  next | prev     next / previous track
  stop            stop playback
  vol [N|+N|-N|+|-] show or set volume (+/-: step 1 below 10, else 3)
  status          show what is playing
  scan            list Cast speakers on the local network
  use IP          switch to the speaker at IP and save it
  music [DIR]     show or set the music folder (default ~/Music)

Config: $config (host=, music=)
EOF
}

case "${1:-}" in
    help | -h | --help) usage; exit ;;
    scan) scan | sort -t. -k4,4n; exit ;;
    use)
        [[ -n ${2:-} ]] || { echo "Usage: hk use <IP>" >&2; exit 1; }
        s=$(info "$2") || { echo "hk: no Cast speaker answers at $2" >&2; exit 1; }
        HK_HOST=$2; save_config
        echo "Using $(name "$s") at $HK_HOST (saved in $config)"; exit ;;
    music)
        [[ -n ${2:-} ]] || { echo "$music"; exit; }
        d=$(realpath -e -- "$2" 2>/dev/null) && [[ -d $d ]] || { echo "hk: no folder at $2" >&2; exit 1; }
        music=$d; save_config
        # hk-cast serves files from the folder it was started with: stop it, the next play starts it with the new one
        pkill -f "^python3 [^ ]*/hk-cast " && echo "Stopped the player; it starts again with the new folder"
        echo "Music folder: $music (saved in $config)"; exit ;;
    "" | play | pause | next | prev | stop | vol | status | _*) ;;
    *) usage >&2; exit 1 ;;  # before the speaker check, so a typo (e.g. "set") is not "no speaker chosen"
esac
[[ -n $HK_HOST ]] || { echo "hk: no speaker chosen. Find one with 'hk scan' and pick it with 'hk use <IP>'" >&2; exit 1; }

case "${1:-}" in
    play)
        [[ -n ${2:-} ]] || { echo "Usage: hk play PATH..." >&2; exit 1; }
        shift
        list=$(for p; do
            r=$(realpath -m --relative-to="$music" "$p")
            [[ $r != ../* ]] || { echo "hk: $p is not inside $music" >&2; exit 1; }
            if [[ -d $p ]]; then tracks "$r" | cut -f3; else echo "$r"; fi
        done)
        player; ctl queue --data-binary @- <<<"$list" >/dev/null; exit ;;
    pause | next | prev | stop) player; ctl "$1" >/dev/null; exit ;;
    vol)
        player
        case ${2:-} in
            "") ctl vol; echo ;;
            +) v=$(ctl vol); ctl "vol?set=$(( v + (v < 10 ? 1 : 3) ))" >/dev/null ;;   # fine steps at low volume
            -) v=$(ctl vol); ctl "vol?set=$(( v - (v <= 10 ? 1 : 3) ))" >/dev/null ;;
            [+-]*) ctl "vol?delta=${2#+}" >/dev/null ;;
            *) ctl "vol?set=$2" >/dev/null ;;
        esac
        exit ;;
    status) player; ctl now; echo; exit ;;
    # Internal sub-calls from fzf
    _now) ctl now; exit ;;
    _show)  # $2 = albums or speakers; built the first time (with progress in the status line), then printed
        f=$HK_DIR/$2
        [[ $2 == songs ]] && { busy "Listing all tracks…"; songs; exit; }  # fresh each time (▶ on the one playing)
        if [[ ! -e $f ]]; then
            case $2 in
                albums) albums >"$f.tmp" ;;
                speakers) busy "Scanning the network for speakers…"; speakers >"$f.tmp" ;;
            esac
            mv "$f.tmp" "$f"
        fi
        if [[ -s $f ]]; then cat "$f"
        elif [[ $2 == albums ]]; then printf '  No audio files in %s – pick your music folder with: hk music <DIR>\t\n' "$music"
        else printf '  No speakers found\t\n'; fi
        exit ;;
    _tracks) tracks "$(st dir)"; exit ;;
    _preview) [[ $(st tab) == albums ]] && tracks "$2" | cut -f1; exit 0 ;;
    _enter)  # $2 = {-1}: dir, file or IP; $3 = {n}
        [[ -n ${2:-} ]] || exit 0
        case $(st tab) in
            albums) tracks "$2" | cut -f3 | ctl queue --data-binary @- >/dev/null ;;
            tracks) tracks "$(st dir)" | cut -f3 | ctl "queue?start=$3" --data-binary @- >/dev/null ;;
            songs)  # the album of the track, from that track
                d=${2%/*}; [[ $2 == */* ]] || d=.
                list=$(tracks "$d" | cut -f3)
                i=$(grep -nxF "$2" <<<"$list" | cut -d: -f1)
                ctl "queue?start=$((${i:-1} - 1))" --data-binary @- <<<"$list" >/dev/null ;;
            speakers)
                put host "$2"; HK_HOST=$2; save_config
                put name "$(name "$(info "$2")")"; rm -f "$HK_DIR/speakers"
                busy "Connecting to $(st name)…"
                player 2>/dev/null || true
                rm -f "$HK_DIR/busy.$BASHPID"
                back_to_albums; exit ;;
        esac
        echo "refresh-preview+transform-footer($self _now)"
        exit ;;
    _scope)  # tab: search album → artist → track (all tracks) → album; the query is kept
        case $(scope) in album) put scope artist ;; artist) put scope track ;; *) put scope album ;; esac
        if [[ $(scope) == track ]]; then to_songs
        elif [[ $(st tab) == albums ]]; then echo "change-nth($(nth))+change-prompt($(scope)> )"
        else to_albums first; fi
        exit ;;
    _key)  # $2 = key, $3-$6 = {1} {2} {-1} {n}. g waits 1 s for the next key (gg, gt, gT).
        tab=$(st tab) g=$(st g) ms=${EPOCHREALTIME/[.,]/} ms=${ms%???} pending=0
        (( ms - ${g:-0} < 1000 )) && pending=1
        put g 0
        case "$2$pending" in
            g0) put g "$ms" ;;
            g1) echo first ;;
            m1) [[ $tab != albums ]] && back_to_albums ;;  # gm, gS: straight to a tab
            S1) [[ $tab != speakers ]] && to_speakers ;;
            t1) case $tab in albums) to_tracks "$3" "$4" "$5" "$6" ;; tracks | songs) to_speakers ;; *) back_to_albums ;; esac ;;
            T1) case $tab in albums) to_speakers ;; *) back_to_albums ;; esac ;;
            l?) [[ $tab == albums ]] && to_tracks "$3" "$4" "$5" "$6" ;;
            h?) [[ $tab != albums ]] && back_to_albums ;;
            r?) [[ $tab == @(albums|speakers) ]] && { rm -f "$HK_DIR/$tab"; echo "reload($self _show $tab)"; } ;;  # albums: read changed folders again
        esac
        exit 0 ;;
    _ticker)  # status line every 0.12 s (spinner); "now playing" every ~1 s, and the preview / track list when the track changes
        set +eE; trap - ERR  # keep going whatever happens; errors are logged by the calls themselves
        last="" shown="" np="?" i=0
        while sleep 0.12; do
            if (( i % 8 == 0 )); then
                read -r HK_HOST <"$HK_DIR/host"
                np=$(ctl now) || np=""
                if [[ -n $np ]]; then
                    cur=$(ctl current)
                    act="change-footer:$np"
                    if [[ $cur != "$last" ]]; then
                        act="refresh-preview+$act"
                        [[ $(st tab) == tracks ]] && act="track-current+reload($self _tracks)+$act"
                    fi
                    fzf_do "$act" && last=$cur  # only remembered once fzf took it, else tried again next second
                fi
            fi
            msg=$(status_line "$i" "$np")  # its own request: a "change-…:text" action must come last
            i=$((i + 1))
            # Sent when it changes, and again every second: a lost update would otherwise stick (e.g. "Fetching…")
            if [[ $msg != "$shown" ]] || (( i % 8 == 1 )); then fzf_do "change-footer-label:$msg" && shown=$msg; fi
        done ;;
    "") ;;
    *) usage >&2; exit 1 ;;
esac

export HK_DIR="$run/hk-ui-$$"
mkdir -p "$HK_DIR"
echo "$(date +%T) UI started (pid $$, $app)" >>"$uilog"
trap 'e=$?; echo "$(date +%T) UI exited (status $e)" >>"$uilog"; rm -rf "$HK_DIR"' EXIT
trap 'exit 129' HUP; trap 'exit 143' TERM  # e.g. the terminal closed: still clean up and log it
player
put host "$HK_HOST"; put name "$(name "$(info "$HK_HOST")")"; put tab albums; put scope album; put apos 0
"$self" _ticker &
trap 'e=$?; echo "$(date +%T) UI exited (status $e)" >>"$uilog"; kill $! 2>/dev/null; rm -rf "$HK_DIR"' EXIT  # hk-cast keeps playing

keys='j,k,g,G,h,l,t,T,r,m,S,space,n,p,+,-,q,/,?'
help='j/k  ctrl-d/u  gg/G   move · half page · top/bottom
l/h                   music ⇄ tracks
gt/gT                 tabs: music → tracks → speakers
gm  gS                go to: music · speakers
/  tab  esc           search · cycle album/artist/track · back
enter                 play album / from track · choose speaker
space  n/p  +/-       pause · next/previous · volume
r                     music: read changed folders again · speakers: scan network
?  q                  shortcuts · quit'
key="transform($self _key {k} {1} {2} {-1} {n})"
fzf --listen="$HK_DIR/fzf.sock" --no-input --ansi \
    --delimiter=$'\t| ‒ ' --with-nth=1,2 --nth=2 --prompt 'album> ' \
    --layout=reverse --border --border-label " $app │ $(st name) │ $(bold '[ Music (gm) ]  Tracks  Speakers (gS)') " \
    --header "$help" --footer ' ' --footer-border=top --footer-label ' Press ? for shortcuts ' \
    --bind "start:reload($self _show albums)+toggle-header,?:toggle-header" \
    --preview "$self _preview {-1}" --preview-window=right,45% \
    --bind 'j:down,k:up,G:last,q:abort,ctrl-d:half-page-down,ctrl-u:half-page-up' \
    --bind "g:${key//\{k\}/g},t:${key//\{k\}/t},T:${key//\{k\}/T},h:${key//\{k\}/h},l:${key//\{k\}/l},r:${key//\{k\}/r}" \
    --bind "m:${key//\{k\}/m},S:${key//\{k\}/S}" \
    --bind "enter:transform($self _enter {-1} {n})" \
    --bind "tab:transform($self _scope)" \
    --bind "space:execute-silent($self pause)+transform-footer($self _now)" \
    --bind "n:execute-silent($self next)+refresh-preview" \
    --bind "p:execute-silent($self prev)+refresh-preview" \
    --bind "+:execute-silent($self vol +)+transform-footer($self _now)" \
    --bind "-:execute-silent($self vol -)+transform-footer($self _now)" \
    --bind "/:show-input+unbind($keys)" \
    --bind "esc:hide-input+rebind($keys)" </dev/null
